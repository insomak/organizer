{# templates/account/create.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Tworzenie konta{% endblock %}

{% block body %}
    <h1>Dodaj nowe konto</h1>

    {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.description) }}
        {{ form_row(form.amount) }}
        {{ form_row(form.bank_account) }}
        {{ form_row(form.account_number) }}
        {{ form_row(form.hidden) }}
        <button class="btn btn-primary">{{ button_label|default('Zapisz konto') }}</button>
    {{ form_end(form) }}
{% endblock %}
